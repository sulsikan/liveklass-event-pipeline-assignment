        "x": 0,
        "y": 26
      }
    },
    {
      "type": "table",
      "title": "Top Users",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-events"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT user_id, COUNT(*) AS event_count FROM events GROUP BY user_id ORDER BY event_count DESC, user_id ASC LIMIT 10;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
